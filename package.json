{
  "name": "brz",
  "module": "./index.js",
  "type": "module",
  "devDependencies": {
    "@mdx-js/esbuild": "^3.1.0",
    "@types/bun": "latest",
    "@types/react-dom": "^19.1.5",
    "@types/react": "^19.1.6",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "react-dom": "^19.1.0",
    "react": "^19.1.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "sass-embedded": "^1.89.0",
    "sharp": "^0.34.2"
  },
  "scripts": {
    "build": "rm -rf ./dist/ && bun run ./app/index.ts",
    "start": "bun run ./app/index.ts --dev",
    "verbose": "bun run ./app/index.ts --dev --verbose",
    "build-brz": "bun build ./app/index.ts --target=bun-darwin-arm64 --compile --outfile ./build/brz-darwin-arm64",
    "build-brz-linux": "bun build ./app/index.ts --target=bun-linux-x64 --compile --outfile ./build/brz-linux-x64",
    "copy-photoswipe-styles": "cp ./node_modules/photoswipe/dist/photoswipe.css ./site/scss/photoswipe.scss",
    "postinstall": "bun run copy-photoswipe-styles",
    "embeddings": "bun ./embeddings/index.ts"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.18",
    "photoswipe": "^5.4.4"
  }
}
